<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the agent connection alive while you switch to other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!--
        The built-in agent reads, edits and runs commands in a project folder you
        choose, e.g. Documents/DroidACP. Android 11+ calls that "All files access"
        and you switch it on in Settings; older versions use the storage permission.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!--
        usesCleartextTraffic: the bridge usually runs as plain ws:// on your own
        network (LAN, Tailscale, or Termux on this tablet), so allow non-TLS sockets.
    -->
    <!--
        Android 11+ hides other apps unless we say which ones we look for. These are
        the helpers for bridge mode, opened from the "Add agent" screen.
    -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.tailscale.ipn" />
        <!-- Speech input for the widget's quick-ask box. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".DroidAcpApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.DroidACP">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The widget's Ask: a small box over the home screen. Its own task (taskAffinity "")
            so opening it doesn't bring the whole app up behind it.
        -->
        <activity
            android:name=".QuickAskActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.DroidACP.QuickAsk"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging" />

        <!-- The Reply box in "agent finished" notifications. -->
        <receiver
            android:name=".service.ReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.AgentWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agent_widget_info" />
        </receiver>

        <!-- The widget's chat list, and its Stop / Allow / Deny buttons. -->
        <service
            android:name=".widget.AgentWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
